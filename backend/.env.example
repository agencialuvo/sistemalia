# Matches backend/docker-compose.yml (postgres service). Port 5434, not the
# default 5432 — this host already has something else listening there.
DATABASE_URL="postgresql://sistemalia:sistemalia@localhost:5434/sistemalia?schema=public"

# Redis (OTP storage, BullMQ queues). Either set REDIS_URL, or the
# individual REDIS_HOST/REDIS_PORT/REDIS_PASSWORD vars — RedisModule
# prefers REDIS_URL when both are present. Port 6380, not the default 6379
# — matches backend/docker-compose.yml (redis service); this host already
# has an unrelated Redis container bound to 6379.
REDIS_URL="redis://localhost:6380"
REDIS_HOST="localhost"
REDIS_PORT="6380"
REDIS_PASSWORD=""

PORT=4000
NODE_ENV="development"

# JWT (Access Token 15m / Refresh Token 7d, both signed with this secret).
JWT_SECRET="change-me-in-production"

# Google reCAPTCHA v3. If left empty in development, RecaptchaGuard bypasses
# verification instead of blocking requests; required in production.
RECAPTCHA_SECRET_KEY=""

# Mail (OTP delivery). If MAIL_HOST is left empty, MailService logs the OTP
# instead of sending a real email — useful for local development.
MAIL_HOST=""
MAIL_PORT=587
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="no-reply@sistemalia.local"

# Google OAuth2 (login "Continuar con Google"). Without real credentials the
# app still boots — only GET /auth/google and its callback will fail.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Where /auth/google/callback redirects after login, and where password-reset
# emails point their link.
FRONTEND_URL="http://localhost:3000"

# SUNAT (consulta de RUC, Feature 02). SUNAT has no free public API, so this
# points at a proxy provider (apis.net.pe, decolecta, ...). Left empty in
# development, SunatService returns a structured mock instead of failing, the
# same way MailService logs instead of sending.
SUNAT_API_URL=""
SUNAT_API_TOKEN=""

# Base URL prefixed to uploaded logo URLs. Must be reachable by the browser:
# the file is served from this API under /static/, not by Next.js.
PUBLIC_BASE_URL="http://localhost:4000"

# Browser origins allowed to call this API (comma-separated). Falls back to
# FRONTEND_URL, then http://localhost:3000. Needed because the Next.js app
# runs on another port — without it the browser blocks every request.
CORS_ORIGINS="http://localhost:3000"
