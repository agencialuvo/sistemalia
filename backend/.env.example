# Matches backend/docker-compose.yml (postgres service). Port 5434, not the
# default 5432 — this host already has something else listening there.
DATABASE_URL="postgresql://sistemalia:sistemalia@localhost:5434/sistemalia?schema=public"

# Redis (OTP storage, BullMQ queues). Either set REDIS_URL, or the
# individual REDIS_HOST/REDIS_PORT/REDIS_PASSWORD vars — RedisModule
# prefers REDIS_URL when both are present. Port 6380, not the default 6379
# — matches backend/docker-compose.yml (redis service); this host already
# has an unrelated Redis container bound to 6379.
REDIS_URL="redis://localhost:6380"
REDIS_HOST="localhost"
REDIS_PORT="6380"
REDIS_PASSWORD=""

PORT=4000
NODE_ENV="development"

# JWT (Access Token 15m / Refresh Token 7d, both signed with this secret).
JWT_SECRET="change-me-in-production"

# Google reCAPTCHA v3. If left empty in development, RecaptchaGuard bypasses
# verification instead of blocking requests; required in production.
RECAPTCHA_SECRET_KEY=""

# Mail (OTP delivery). If MAIL_HOST is left empty, MailService logs the OTP
# instead of sending a real email — useful for local development.
MAIL_HOST=""
MAIL_PORT=587
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="no-reply@sistemalia.local"

# Google OAuth2 (login "Continuar con Google"). Without real credentials the
# app still boots — only GET /auth/google and its callback will fail.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Google Calendar Jerárquico (Feature 09) — MISMO GOOGLE_CLIENT_ID/SECRET de
# arriba (un solo cliente OAuth de Google Cloud Console puede tener varias
# redirect URI registradas), pero con su propio callback y su propio scope
# de escritura (`.../auth/calendar`, pedido con access_type=offline +
# prompt=consent para obtener refresh_token) — separado de "Continuar con
# Google" porque ese es scope `email profile`, de solo lectura de identidad.
GOOGLE_REDIRECT_URI="http://localhost:4000/integrations/google/callback"

# Google Calendar Jerárquico (Feature 09) — clave AES-256-GCM que encripta
# Tenant.googleAccessToken/googleRefreshToken en reposo. Hex de 64
# caracteres (32 bytes); genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin configurar, EncryptionService cae a una clave de desarrollo fija en
# NODE_ENV != production (con warning) y falla rápido en producción — mismo
# criterio que JWT_SECRET, pero sin el default heredable: un token de Google
# guardado con la clave de desarrollo es un incidente de seguridad.
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Integraciones No-Code (Feature 10) — App de Meta for Developers usada por
# SocialChannelsService para intercambiar el token corto que entrega el SDK
# de Facebook Login (FB.login() en el navegador) por un token de usuario de
# larga duración, y luego listar las Páginas/cuentas de Instagram que ese
# usuario administra. Sin configurar, POST /marketing/channels/meta/connect
# devuelve 400 en vez de conectar nada — a diferencia de SUNAT_API_URL, no
# hay un modo mock razonable para un endpoint cuyo trabajo es persistir
# tokens reales de terceros.
META_APP_ID=""
META_APP_SECRET=""

# Cadena arbitraria que TÚ eliges al configurar la suscripción de Webhooks en
# el panel de Meta for Developers — Meta la manda de vuelta en
# GET /webhooks/meta?hub.verify_token=... y MetaWebhooksController solo
# responde el challenge si coincide con este valor. Sin configurar, la
# verificación de webhooks siempre se rechaza (403) — no hay modo mock
# razonable para un secreto compartido que tú mismo defines.
META_WEBHOOK_VERIFY_TOKEN=""

# SocialChannel.accessToken/refreshToken se cifran con la MISMA
# GOOGLE_TOKEN_ENCRYPTION_KEY de arriba — EncryptionService ahora es
# @Global() (CommonModule) y no tiene una variable de entorno propia por
# módulo consumidor.

# Where /auth/google/callback redirects after login, and where password-reset
# emails point their link.
FRONTEND_URL="http://localhost:3000"

# SUNAT (consulta de RUC, Feature 02). SUNAT has no free public API, so this
# points at a proxy provider (apis.net.pe, decolecta, ...). Left empty in
# development, SunatService returns a structured mock instead of failing, the
# same way MailService logs instead of sending.
SUNAT_API_URL=""
SUNAT_API_TOKEN=""

# Base URL prefixed to uploaded logo URLs. Must be reachable by the browser:
# the file is served from this API under /static/, not by Next.js.
PUBLIC_BASE_URL="http://localhost:4000"

# Browser origins allowed to call this API (comma-separated). Falls back to
# FRONTEND_URL, then http://localhost:3000. Needed because the Next.js app
# runs on another port — without it the browser blocks every request.
CORS_ORIGINS="http://localhost:3000"
